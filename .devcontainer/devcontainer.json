{
  "name": "convergence-microscope",
  // containerlab Docker-in-Docker image (Debian bookworm, Python 3.11, dockerd, containerlab).
  // Pinned: the containerlab version inside the image equals the tag.
  "image": "ghcr.io/srl-labs/containerlab/devcontainer-dind:0.83.0",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  // eBPF programs must load and attach from inside this container.
  "privileged": true,
  "mounts": [
    "source=/sys/kernel/debug,target=/sys/kernel/debug,type=bind",
    "source=/lib/modules,target=/lib/modules,type=bind,readonly"
  ],
  "remoteUser": "vscode",
  // Go is installed into /opt/go by post-create.sh. The go feature unpacks over
  // the image's bundled /usr/local/go (1.22) and leaves stale runtime files.
  "remoteEnv": {
    "GOROOT": "/opt/go",
    "PATH": "/opt/go/bin:/home/vscode/go/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
