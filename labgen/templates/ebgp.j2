{# RFC 7938 style eBGP. Leaves export only their own prefixes (EXPORT matches
   prefix-list LOCAL) so they never carry transit traffic; spines and mesh
   routers export everything. #}
router bgp {{ r.asn }}
 bgp router-id {{ r.router_id }}
 bgp bestpath as-path multipath-relax
 no bgp network import-check
 timers bgp {{ r.timers.bgp_keepalive_s }} {{ r.timers.bgp_hold_s }}
{% for i in r.ifaces if i.kind == "fabric" %}
 neighbor {{ i.peer_address }} remote-as {{ asns[i.peer] }}
 neighbor {{ i.peer_address }} description {{ i.peer }}
{% if plan.bfd %}
 neighbor {{ i.peer_address }} bfd
 neighbor {{ i.peer_address }} bfd profile fast
{% endif %}
 neighbor {{ i.peer_address }} timers connect {{ r.timers.bgp_connect_retry_s }}
{% endfor %}
 use-underlays-nexthop-weight
 !
 address-family ipv4 unicast
  network {{ r.loopback }}
{% for s in r.host_subnets %}
  network {{ s }}
{% endfor %}
{% for i in r.ifaces if i.kind == "fabric" %}
  neighbor {{ i.peer_address }} route-map IMPORT in
  neighbor {{ i.peer_address }} route-map EXPORT out
{% endfor %}
 exit-address-family
exit
!
